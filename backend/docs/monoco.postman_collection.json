{
  "info": {
    "name": "Monoco — 26 operações revisadas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Exemplos para execução individual. Primeiro cadastre e faça login. Criações de personagem, campanha e memória capturam IDs. Não execute a coleção inteira sem escolher a ordem: troca de senha e logout invalidam sessões, e exclusões removem os dados dos exemplos. A narração retorna SSE. PATCH de configuração aceita preferências, provedor/modelo/chave ou removerChave=true, como explicado no README."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "email",
      "value": "aventureiro@exemplo.com"
    },
    {
      "key": "senha",
      "value": "senha12345"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "personagem_id",
      "value": ""
    },
    {
      "key": "campanha_id",
      "value": ""
    },
    {
      "key": "memoria_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "GET /personagens/{personagemId}",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/personagens/{{personagem_id}}"
      }
    },
    {
      "name": "PUT /personagens/{personagemId}",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/personagens/{{personagem_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Aurel Falken\",\n  \"classe\": \"Paladino\",\n  \"compartilharSegredos\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
